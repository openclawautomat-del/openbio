{
  "name": "openbio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted link-in-bio, URL shortener, QR codes and analytics.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node server.js",
    "start:standalone": "node .next/standalone/server.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.72.0",
    "mysql2": "^3.24.6",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
