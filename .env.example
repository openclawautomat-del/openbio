# --- Database (MySQL on the same host) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=openbio
DB_USER=openbio
DB_PASSWORD=change-me

# --- Security ---
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Signs tokens and encrypts mailbox passwords stored in the database. Changing it invalidates both.
AUTH_SECRET=

# --- Branding (everything user-visible derives from these; admin settings override them) ---
APP_NAME=Open Bio
APP_URL=http://localhost:3000
APP_TAGLINE=Your links, one page, your server.
APP_SUPPORT_EMAIL=support@example.com
APP_PRIMARY_COLOR=#0E7C66

# --- Optional ---
# Set to "false" (or 0) to disable Phase 2 features (custom domains, teams, CSV, goals ...)
FEATURE_PHASE2=true
# Local upload directory (default ./storage/uploads). Must persist across deploys.
UPLOAD_DIR=
# Trust proxy headers for client IP (leave true behind Hostinger / Cloudflare)
TRUST_PROXY=true
